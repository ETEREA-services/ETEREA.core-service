classDiagram
    direction TB

    namespace compras.proveedor {
        class Proveedor {
            <<Domain Model>>
            +Integer proveedorId
            +String razonSocial
            +Integer negocioId
            +String cuit
            +String domicilio
            +String telefono
            +String fax
            +String email
            +Integer posicion
            +String celular
            +String numeroInscripcionIngresosBrutos
            +Integer ingresosBrutosContribuyenteId
            +Integer proveedorCategoriaId
            +Integer ingresosBrutosCategoriaId
            +Integer reparticionId
            +Byte transporte
        }

        class ProveedorService {
            <<Service>>
            +findByProveedorId(Integer) Proveedor
        }

        class FindProveedorByIdUseCase {
            <<interface>>
            +findByProveedorId(Integer) Optional~Proveedor~
        }

        class ProveedorRepository {
            <<interface>>
            +findByProveedorId(Integer) Optional~Proveedor~
        }
    }

    namespace infrastructure {
        class ProveedorEntity {
            <<JPA Entity>>
            +Integer proveedorId
            +String razonSocial
            +Integer negocioId
            +String cuit
            +String domicilio
            +String telefono
            +String fax
            +String email
            +Integer posicion
            +String celular
            +String numeroInscripcionIngresosBrutos
            +Integer ingresosBrutosContribuyenteId
            +Integer proveedorCategoriaId
            +Integer ingresosBrutosCategoriaId
            +Integer reparticionId
            +Byte transporte
        }

        class JpaProveedorRepositoryAdapter {
            <<Adapter>>
            +findByProveedorId(Integer) Optional~Proveedor~
        }

        class ProveedorMapper {
            <<Mapper>>
            +toDomain(ProveedorEntity) Proveedor
            +toEntity(Proveedor) ProveedorEntity
        }

        class JpaProveedorRepository {
            <<JpaRepository>>
            +findByProveedorId(Integer) Optional~ProveedorEntity~
        }
    }

    namespace infrastructure.web {
        class ProveedorController {
            <<REST Controller>>
            +findByProveedorId(Integer) ResponseEntity
        }

        class ProveedorResponse {
            <<Response DTO>>
            +Integer proveedorId
            +String razonSocial
            +Integer negocioId
            +String cuit
            +String domicilio
            +String telefono
            +String fax
            +String email
            +Integer posicion
            +String celular
            +String numeroInscripcionIngresosBrutos
            +Integer ingresosBrutosContribuyenteId
            +Integer proveedorCategoriaId
            +Integer ingresosBrutosCategoriaId
            +Integer reparticionId
            +Byte transporte
        }

        class ProveedorDtoMapper {
            <<Mapper>>
            +toResponse(Proveedor) ProveedorResponse
        }
    }

    ProveedorService --> FindProveedorByIdUseCase

    FindProveedorByIdUseCase ..> ProveedorRepository

    ProveedorRepository <|.. JpaProveedorRepositoryAdapter
    JpaProveedorRepositoryAdapter --> ProveedorMapper
    JpaProveedorRepositoryAdapter --> JpaProveedorRepository

    ProveedorMapper --> ProveedorEntity
    ProveedorMapper --> Proveedor

    ProveedorController --> ProveedorService
    ProveedorController --> ProveedorDtoMapper
    ProveedorDtoMapper --> Proveedor